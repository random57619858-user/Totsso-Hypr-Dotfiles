* {
<* if {{ is_dark_mode }} *>
    bg-base:        {{colors.surface_container_lowest.default.hex}};
<* else *>
    bg-base:        {{colors.surface_container_low.default.hex}};
<* endif *>
    bg-surface:     {{colors.surface_container.default.hex}};
    bg-field:       {{colors.surface_container_high.default.hex}};
    bg-selected:    {{colors.primary_container.default.hex}};

    fg-main:        {{colors.on_surface.default.hex}};
    fg-bright:      {{colors.on_surface.default.hex}};
    fg-muted:       {{colors.on_surface_variant.default.hex}};
    fg-selected:    {{colors.on_primary_container.default.hex}};

    accent:         {{colors.primary.default.hex}};
    accent-soft:    {{colors.secondary.default.hex}};
    accent-alt:     {{colors.tertiary.default.hex}};

    outline-soft:   {{colors.outline_variant.default.hex}};
    outline:        {{colors.outline.default.hex}};
}
