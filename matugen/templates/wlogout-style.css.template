* {
    background-image: none;
    transition: 180ms ease;
    font-family: "JetBrainsMono Nerd Font", sans-serif;
    font-size: 14px;
    font-weight: bold;
}

window {
    background-color: rgba(0, 0, 0, 0.55);
}

button {
    color: {{colors.on_surface.default.hex}};
    background-color: {{colors.surface_container.default.hex}};
    border: 2px solid {{colors.outline_variant.default.hex}};
    border-radius: 22px;
    margin: 14px;
    padding: 18px;
    background-repeat: no-repeat;
    background-position: center 32%;
    background-size: 26%;
    box-shadow: none;
    text-shadow: none;
}

button:focus,
button:active,
button:hover {
    background-color: {{colors.primary_container.default.hex}};
    color: {{colors.on_primary_container.default.hex}};
    border-color: {{colors.primary.default.hex}};
    outline-style: none;
}

#logout {
    background-image: image(url("/usr/share/wlogout/icons/logout.png"), url("@HOME@/.local/share/wlogout/icons/logout.png"));
}

#suspend {
    background-image: image(url("/usr/share/wlogout/icons/suspend.png"), url("@HOME@/.local/share/wlogout/icons/suspend.png"));
}

#reboot {
    background-image: image(url("/usr/share/wlogout/icons/reboot.png"), url("@HOME@/.local/share/wlogout/icons/reboot.png"));
}

#shutdown {
    background-image: image(url("/usr/share/wlogout/icons/shutdown.png"), url("@HOME@/.local/share/wlogout/icons/shutdown.png"));
}
