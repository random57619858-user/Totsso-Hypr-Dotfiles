<* if {{ is_dark_mode }} *>
@define-color bg              {{colors.surface.default.hex}};
@define-color bg_low          {{colors.surface_container_low.default.hex}};
<* else *>
@define-color bg              {{colors.surface_container_low.default.hex}};
@define-color bg_low          {{colors.surface_container.default.hex}};
<* endif *>
@define-color bg_alt          {{colors.surface_container.default.hex}};
@define-color bg_high         {{colors.surface_container_high.default.hex}};
@define-color bg_highest      {{colors.surface_container_highest.default.hex}};
@define-color border          {{colors.outline_variant.default.hex}};
@define-color border_strong   {{colors.outline.default.hex}};
@define-color fg              {{colors.on_surface.default.hex}};
@define-color fg_dim          {{colors.on_surface_variant.default.hex}};
@define-color primary         {{colors.primary.default.hex}};
@define-color on_primary      {{colors.on_primary.default.hex}};
@define-color primary_ctr     {{colors.primary_container.default.hex}};
@define-color on_primary_ctr  {{colors.on_primary_container.default.hex}};
@define-color secondary       {{colors.secondary.default.hex}};
@define-color on_secondary    {{colors.on_secondary.default.hex}};
@define-color secondary_ctr   {{colors.secondary_container.default.hex}};
@define-color on_secondary_ctr {{colors.on_secondary_container.default.hex}};
@define-color tertiary        {{colors.tertiary.default.hex}};
@define-color on_tertiary     {{colors.on_tertiary.default.hex}};
@define-color tertiary_ctr    {{colors.tertiary_container.default.hex}};
@define-color error           {{colors.error.default.hex}};
@define-color on_error        {{colors.on_error.default.hex}};
@define-color error_ctr       {{colors.error_container.default.hex}};
@define-color on_error_ctr    {{colors.on_error_container.default.hex}};
