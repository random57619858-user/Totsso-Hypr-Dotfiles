{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "modules-left": [
        "hyprland/workspaces",
        "group/apps",
        "custom/cava"
    ],
    "modules-center": [
        "mpris",
        "clock"
    ],
    "modules-right": [
        "group/info",
        "pulseaudio",
        "custom/network",
        "battery",
        "group/session"
    ],
    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{name}"
    },
    "custom/cava": {
        "exec": "~/.config/waybar/cava.sh",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false
    },
    "group/apps": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 260,
            "children-class": "apps-child",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/apps",
            "wlr/taskbar#apps"
        ]
    },
    "custom/apps": {
        "format": "Apps",
        "tooltip": false
    },
    "wlr/taskbar#apps": {
        "format": "{icon}",
        "icon-size": 16,
        "tooltip": true,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "all-outputs": true
    },
    "mpris": {
        "format": "󰎆 {artist} - {title}",
        "format-paused": "󰏤 {artist} - {title}",
        "max-length": 26,
        "tooltip": true,
        "tooltip-format": "{player}\n{title}\n{artist} — {album}\n{length}",
        "tooltip-format-paused": "⏸ {title}\n{artist} — {album}\n{length}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "clock": {
        "format": "󰥔 {:%H:%M  •  %d/%m}",
        "tooltip": true,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "today": "<b><u>{}</u></b>"
            }
        }
    },
    "custom/temperature": {
        "exec": "~/.config/waybar/temp.sh",
        "interval": 5,
        "return-type": "json",
        "format": "{}",
        "tooltip": true
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/totsso-power.sh"
    },
    "custom/dnd": {
        "exec": "~/.config/waybar/dnd.sh status",
        "interval": 2,
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "on-click": "~/.config/waybar/dnd.sh toggle; pkill -RTMIN+8 waybar",
        "signal": 8
    },
    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 2,
        "tooltip": true,
        "tooltip-format": "Load: {load}\nFrequency: {min_frequency} - {max_frequency} GHz\nAverage: {avg_frequency} GHz"
    },
    "memory": {
        "format": "󰘚 {percentage}%",
        "interval": 5,
        "tooltip": true,
        "tooltip-format": "Used: {used:0.1f} GiB / {total:0.1f} GiB\nAvailable: {avail:0.1f} GiB"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 0%",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁼",
            "󰁽",
            "󰁿",
            "󰂁",
            "󰁹"
        ],
        "tooltip": true,
        "tooltip-format": "{timeTo}\n{capacity}% · {power}W"
    },
    "group/session": {
        "orientation": "horizontal",
        "modules": [
            "custom/dnd",
            "custom/power"
        ],
        "name": "session"
    },
    "custom/network": {
        "exec": "~/.config/waybar/net.sh",
        "interval": 5,
        "return-type": "json",
        "format": "{}",
        "tooltip": true
    },
    "group/info": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 260,
            "children-class": "info-child",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/info",
            "cpu",
            "memory",
            "custom/temperature"
        ]
    },
    "custom/info": {
        "format": "Info",
        "tooltip": false
    }
}
